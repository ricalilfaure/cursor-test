# Configurações para serviços de resolução de captcha (opcional)
# Escolha o serviço: '2captcha' ou 'anticaptcha'
CAPTCHA_SERVICE=2captcha

# API Key do serviço escolhido
# Para 2Captcha: https://2captcha.com/
# Para AntiCaptcha: https://anti-captcha.com/
CAPTCHA_API_KEY=your_api_key_here

# Configurações do navegador
HEADLESS=False
WAIT_TIME=10
